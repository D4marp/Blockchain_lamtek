# ============================================================
# SERVICE 2 — KAFKA (single-node, KRaft / TANPA Zookeeper)
# Build context: ./kafka
# ============================================================
#
# >>> JEBAKAN #1 DI PaaS: KAFKA_ADVERTISED_LISTENERS <<<
# Klien konek dulu ke broker, lalu broker membalas alamat *advertised* dan klien
# RECONNECT ke situ. Jadi host advertised HARUS sama persis dengan KAFKA_BROKERS
# di backend. Di overlay Swarm bersama, pakai nama service "kafka":
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
#
# Kalau backend mengakses Kafka via hostname PUBLIK PaaS, advertise hostname itu
# + port TCP yang dipublish (Kafka butuh TCP, bukan HTTP), mis:
#   KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka_lamtek.paas.hcm-lab.id:9092

# Sisanya sudah punya default di Dockerfile; override hanya bila perlu.
KAFKA_NODE_ID=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
# UUID base64 valid; samakan agar storage tidak ter-format ulang tiap restart.
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
