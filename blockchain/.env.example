# ===========================================
# Blockchain (Hardhat + Hyperledger Besu) Configuration
# ===========================================
# Used by hardhat.config.js for compiling and deploying the smart contracts.
#
# Local docker-compose: BESU_RPC_URL=http://besu-node1:8545 (inside the network)
#                       or http://localhost:8545 (from the host).
# PaaS:                 set BESU_RPC_URL to your Besu RPC endpoint.

# JSON-RPC endpoint of the target Besu node (the "besu" hardhat network)
BESU_RPC_URL=http://localhost:8545

# Chain ID of the Besu network (must match besu genesis; default dev chain = 1337)
BESU_CHAIN_ID=1337

# ===========================================
# Deployer account
# ===========================================
# Private key (without 0x is also accepted by ethers) used to deploy contracts.
# NEVER commit a real funded key. For local dev use one of the Besu dev accounts.
# Leave empty to fall back to the hardhat default accounts on the localhost network.
BLOCKCHAIN_PRIVATE_KEY=

# ===========================================
# Deployed contract addresses (filled in after running scripts/deploy.js)
# Mirror these into backend/.env so the backend can talk to the contracts.
# ===========================================
AKREDITASI_CONTRACT_ADDRESS=
ASESMEN_KECUKUPAN_CONTRACT_ADDRESS=
ASESMEN_LAPANGAN_CONTRACT_ADDRESS=
DOKUMEN_IPFS_CONTRACT_ADDRESS=
