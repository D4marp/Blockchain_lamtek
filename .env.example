# ============================================
# Root environment file for docker-compose
# ============================================
# Copy to ".env" (docker compose loads it automatically) and adjust as needed:
#   cp .env.example .env
#
# These values are the variables interpolated by docker-compose.yml. The
# per-service runtime config lives in each service's environment block; this
# file only needs to override the ${VARS} that compose references.
#
# For PaaS/production deployment see .env.paas instead.

NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Frontend (Next.js)
# ============================================
FRONTEND_PORT=3002
# Browser-facing API URL. Local docker: the backend is published on host :3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================
# Backend (NestJS api-gateway)
# ============================================
# Host port -> container 3000. The backend always listens on 3000 internally.
BACKEND_PORT=3001
PORT=3000

# ============================================
# Database (MySQL)
# ============================================
DATABASE_URL=mysql://lamtek:lamtek123@mysql:3306/lamtek_db
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lamtek_db
MYSQL_USER=lamtek
MYSQL_PASSWORD=lamtek123
MYSQL_PORT=3306

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ============================================
# JWT
# ============================================
# Change this in any non-local environment.
JWT_SECRET=lamtek-secret-key-2025-change-in-production
JWT_EXPIRES_IN=24h

# ============================================
# Blockchain (Hyperledger Besu)
# ============================================
BESU_RPC_URL=http://besu-node1:8545
BESU_WS_URL=ws://besu-node1:8546
SIGNER_MODE=external

# ============================================
# IPFS
# ============================================
IPFS_API_URL=http://ipfs-node:5001
IPFS_GATEWAY_URL=http://ipfs-node:8080
# Browser-facing link (must be reachable from the user's machine, not just the Docker network)
IPFS_PUBLIC_GATEWAY_URL=http://localhost:8888

# ============================================
# Kafka
# ============================================
KAFKA_BROKERS=kafka:9092
DATA_FILE_WORKFLOW_MODE=kafka
