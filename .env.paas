# PaaS Deployment Configuration
# Define environment variables required for different PaaS platforms

# ============================================
# Common Environment Variables
# ============================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://api-gateway:3000

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=3001
PORT=3000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=mysql://lamtek:lamtek123@mysql:3306/lamtek_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=10000

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lamtek_db
MYSQL_USER=lamtek
MYSQL_PASSWORD=lamtek123
MYSQL_PORT=3306

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_TTL=3600

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=lamtek-secret-key-2025
JWT_EXPIRES_IN=24h

# ============================================
# Blockchain Configuration (Besu)
# ============================================
BESU_RPC_URL=http://besu-node1:8545
BESU_WS_URL=ws://besu-node1:8546
BESU_RPC_PORT=8545
BESU_WS_PORT=8546
BESU_P2P_PORT=30303

# ============================================
# IPFS Configuration
# ============================================
IPFS_API_URL=http://ipfs-node:5001
IPFS_GATEWAY_URL=http://ipfs-node:8888
IPFS_SWARM_PORT=4001
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8888

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=lamtek-backend
KAFKA_GROUP_ID=lamtek-consumer-group
KAFKA_PORT=9092
KAFKA_HOST_PORT=29092

# ============================================
# Zookeeper Configuration
# ============================================
ZOOKEEPER_PORT=2181

# ============================================
# Service Healthcheck Configuration
# ============================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=15s
