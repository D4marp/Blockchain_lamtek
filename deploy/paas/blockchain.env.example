# ============================================================
# SERVICE 1 — BLOCKCHAIN (Hardhat single node)
# Push as its own microservice. Build context: ./blockchain
# ============================================================
# Hardhat state is in-memory and resets on restart. The entrypoint
# (scripts/docker-entrypoint.sh) auto-deploys the contracts on boot, so the
# addresses below are reproduced deterministically every time.

# Bind address/port for the JSON-RPC node (keep 0.0.0.0 inside a container).
RPC_HOST=0.0.0.0
RPC_PORT=8545

# Deploy contracts automatically on container start. Keep "true".
DEPLOY_ON_START=true

# Optionally run the seed script after deploy.
RUN_SEED=false

# ---- Reference only: deterministic addresses produced by deploy.js ----
# The BACKEND consumes these (do NOT set them here; they are baked by deploy):
#   AKREDITASI_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
#   ASESMEN_KECUKUPAN_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
#   ASESMEN_LAPANGAN_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
#   DOKUMEN_IPFS_CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# IPFS digabung ke container ini (API :5001, Gateway :8080)
ENABLE_IPFS=true
